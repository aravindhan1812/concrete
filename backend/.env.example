NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://concrete:concrete@localhost:5432/concrete
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173

# Object storage (MinIO from docker-compose locally; S3 / Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=concrete
S3_ACCESS_KEY=concrete
S3_SECRET_KEY=concrete-secret
S3_FORCE_PATH_STYLE=true
